pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'halimatou/halimatou_batoure:latest'
        GIT_BRANCH = 'Halimatou_Batoure' 
        GIT_REPO = 'https://github.com/Limatou4/ISIBURGERS.git' 
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                  
                    git branch: "${GIT_BRANCH}", url: "${GIT_REPO}"
                }
            }
        }

        stage('Installer les dépendances Laravel') {
            steps {
                script {
                   
                    sh 'curl -sS https://getcomposer.org/installer | php'
                    sh 'php composer.phar install'
                }
            }
        }

        stage('Construire l\'image Docker') {
            steps {
                script {
                   
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                }
            }
        }

        stage('Pousser l\'image Docker vers Docker Hub') {
            steps {
                script {
                   
                    sh 'docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD'

                 
                    sh 'docker push ${DOCKER_IMAGE}'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline exécuté avec succès 🎉'
        }
        failure {
            echo 'Le pipeline a échoué ❌'
        }
    }
}
